<Window x:Class="DanmuFree.App.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码登录" Height="380" Width="320"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <Image x:Name="QrImage" Width="220" Height="220"/>
    <TextBlock x:Name="StatusText" Text="正在获取二维码…" Foreground="#FFCCCCCC"
               HorizontalAlignment="Center" Margin="0,10,0,4"/>
    <Button x:Name="RefreshBtn" Content="刷新二维码" Click="OnRefresh"
            HorizontalAlignment="Center" Margin="0,4" Visibility="Collapsed"/>
  </StackPanel>
</Window>
