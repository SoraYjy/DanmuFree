<Window x:Class="DanmuFree.App.Views.NotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:DanmuFree.Core.Models;assembly=DanmuFree.Core"
        xmlns:c="clr-namespace:DanmuFree.App.Converters"
        Title="进场/关注/礼物" Height="320" Width="300"
        Topmost="{Binding EffectiveNotifyTopmost}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
  <Window.Resources>
    <c:OpacityToBackgroundConverter x:Key="OpacityToBg"/>
    <!-- 进场 / 关注 / 礼物 单行模板：昵称(金) + 动作(柔色) / 礼物(金色加粗，在 Extra)。字体/字号绑通知窗独立设置。 -->
    <DataTemplate DataType="{x:Type m:RichMessage}">
      <TextBlock TextWrapping="Wrap"
                 Foreground="#FFB0BEC5"
                 FontFamily="{Binding DataContext.NotifyFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                 FontSize="{Binding DataContext.NotifyFontSize, RelativeSource={RelativeSource AncestorType=Window}}">
        <Run Text="{Binding UserName}" Foreground="#FFFFD54F"/><Run Text=" "/><Run Text="{Binding Text}"/><Run Text="{Binding Extra}" Foreground="#FFFFD54F" FontWeight="Bold"/>
      </TextBlock>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 标题条：仅标签（识别 + 拖动区），无控件。沉浸时整条折叠。 -->
    <Border Grid.Row="0" Background="#CC1E1E1E" Padding="8,3"
            PreviewMouseLeftButtonDown="OnBackgroundMouseDown">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsNotifyFloating}" Value="True">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="进场/关注/礼物" Foreground="#FFCCCCCC" VerticalAlignment="Center" FontSize="12"/>
    </Border>

    <!-- 进场 / 关注 列表区：沉浸时背景更透 + 鼠标穿透，与主弹幕窗同款。 -->
    <Border Grid.Row="1" Background="{Binding EffectiveNotifyOpacity, Converter={StaticResource OpacityToBg}}"
            PreviewMouseLeftButtonDown="OnBackgroundMouseDown">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsNotifyFloating}" Value="True">
              <Setter Property="IsHitTestVisible" Value="False"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <ListBox x:Name="NotifyList" ItemsSource="{Binding NotifyMessages}" Background="Transparent" BorderThickness="0"
               FontFamily="{Binding NotifyFontFamily}" FontSize="{Binding NotifyFontSize}"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               VirtualizingStackPanel.ScrollUnit="Pixel"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Resources>
          <!-- 沉浸时滚动条透明占位（不改视口宽度，避免虚拟化 re-realize 抖动） -->
          <Style TargetType="ScrollBar">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNotifyFloating}" Value="True">
                <Setter Property="Opacity" Value="0"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.Resources>
        <ListBox.Style>
          <Style TargetType="ListBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNotifyFloating}" Value="True">
                <Setter Property="IsHitTestVisible" Value="False"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.Style>
      </ListBox>
    </Border>
  </Grid>
</Window>
