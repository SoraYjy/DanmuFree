<Window x:Class="DanmuFree.App.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DanmuFree.App.Converters"
        xmlns:vm="clr-namespace:DanmuFree.App.ViewModels"
        Title="控制" Width="360" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#FF1E1E1E"
        ResizeMode="CanResizeWithGrip"
        MinWidth="340" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:EnumToBoolConverter x:Key="EnumToBool"/>
    <conv:StringEqualsConverter x:Key="StringEquals"/>
  </Window.Resources>
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 标题栏（拖动区）：按住空白处拖动；— 最小化到任务栏（常驻），× 退出程序 -->
    <Border Grid.Row="0" Background="#FF2A2A2A" Padding="8,4"
            PreviewMouseLeftButtonDown="OnTitleMouseDown">
      <Grid>
        <TextBlock Text="控制" Foreground="#FFCCCCCC" VerticalAlignment="Center" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-2,-4,0">
          <Button Content="—" Click="OnMinimize" Width="28" Height="22" Margin="0,0,2,0"
                  Foreground="#FFCCCCCC" Background="Transparent" BorderThickness="0" FontSize="14" ToolTip="最小化到任务栏（常驻，可随时恢复）"/>
          <Button Content="×" Click="OnExit" Width="28" Height="22"
                  Foreground="#FFCCCCCC" Background="Transparent" BorderThickness="0" FontSize="14" ToolTip="退出程序"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="8">
        <!-- 账号信息 -->
        <Border Visibility="{Binding ShowUserInfo, Converter={StaticResource BoolToVis}}"
                Background="#FF2A2A2A" CornerRadius="3" Padding="6,3" Margin="0,0,0,6"
                HorizontalAlignment="Left">
          <TextBlock Text="{Binding UserInfo}" Foreground="#FF4FC3F7"/>
        </Border>

        <!-- 平台选择（单选） -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <RadioButton Content="B站" GroupName="Platform" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                       IsChecked="{Binding Platform, Converter={StaticResource EnumToBool}, ConverterParameter=Bilibili}"/>
          <RadioButton Content="抖音" GroupName="Platform" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="12,0,0,0"
                       IsChecked="{Binding Platform, Converter={StaticResource EnumToBool}, ConverterParameter=Douyin}"
                       ToolTip="抖音匿名连接，无需 Cookie；弹幕签名依赖本机 node（首次连接约 2s）"/>
        </StackPanel>

        <!-- 房间行：按平台显示对应房间号输入；连接/断开共用 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBox Width="100" Text="{Binding RoomIdInput}" ToolTip="B站房间号" VerticalAlignment="Center"
                   Visibility="{Binding IsBilibili, Converter={StaticResource BoolToVis}}"/>
          <TextBox Width="100" Text="{Binding DouyinRoomId}" ToolTip="抖音房间号（live.douyin.com/ 后那串）" VerticalAlignment="Center"
                   Visibility="{Binding IsDouyin, Converter={StaticResource BoolToVis}}"/>
          <Button Content="连接" Command="{Binding ConnectCommand}" Margin="4,0" VerticalAlignment="Center"/>
          <Button Content="断开" Command="{Binding DisconnectCommand}" Margin="4,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="#FFCCCCCC" Margin="0,0,0,6"/>

        <!-- 统计 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFCCCCCC"><Run Text="在线 "/><Run Text="{Binding OnlineCount}" Foreground="#FF4FC3F7"/></TextBlock>
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFCCCCCC"><Run Text="看过 "/><Run Text="{Binding WatchedCount}" Foreground="#FFC1FF"/></TextBlock>
          <TextBlock VerticalAlignment="Center" Foreground="#FFCCCCCC"><Run Text="赞 "/><Run Text="{Binding LikesCount}" Foreground="#FFFF8A80"/></TextBlock>
        </StackPanel>

        <!-- 设置：分 TAB —— 弹幕 / 进场·关注 -->
        <TabControl Background="#FF1E1E1E" Padding="0" Margin="0,0,0,6">

          <!-- 弹幕设置 -->
          <TabItem Header="弹幕">
            <TabItem.Resources>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFCCCCCC"/>
              </Style>
            </TabItem.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="6">
                <CheckBox Content="窗口置顶" IsChecked="{Binding Topmost}" Foreground="#FFCCCCCC" Margin="0,2"/>
                <CheckBox Content="悬浮（沉浸置顶 · 鼠标穿透）" IsChecked="{Binding IsFloating}" Foreground="#FFCCCCCC" Margin="0,2"
                          ToolTip="置顶 + 半透明 + 鼠标完全穿透：游戏中点窗口不影响、不抢焦点。退出在此取消勾选"/>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="背景透明度" VerticalAlignment="Center" Width="72"/>
                  <Slider Minimum="0.3" Maximum="1" Value="{Binding Opacity}" TickFrequency="0.05" Width="220" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="字号" VerticalAlignment="Center" Width="72"/>
                  <Slider Minimum="8" Maximum="100" Value="{Binding FontSize}" TickFrequency="1" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center"
                          ToolTip="8~100（4K 大屏可开大）"/>
                </StackPanel>
                <!-- 文字描边：给每条弹幕套一圈硬外轮廓（游戏画面等复杂背景上更易读） -->
                <CheckBox Content="文字描边" IsChecked="{Binding DanmuOutline}" Foreground="#FFCCCCCC" Margin="0,4"
                          ToolTip="给每条弹幕加一圈硬描边（默认黑色，可在下两行改色/粗细）"/>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="描边色" VerticalAlignment="Center" Width="72"/>
                  <Button Width="34" Height="22" Click="OnPickDanmuOutlineColor" ToolTip="点开颜色盘选择"
                          Background="{Binding DanmuOutlineColor}" BorderBrush="#FF888888"/>
                  <TextBox Text="{Binding DanmuOutlineColor, UpdateSourceTrigger=PropertyChanged}" Width="78" Margin="6,0,0,0" VerticalAlignment="Center"
                           ToolTip="也可手填 #RRGGBB / #AARRGGBB"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="描边粗细" VerticalAlignment="Center" Width="72"/>
                  <Slider Minimum="0.5" Maximum="6" Value="{Binding DanmuOutlineThickness}" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="字体" VerticalAlignment="Center" Width="72"/>
                  <ComboBox ItemsSource="{Binding SystemFonts}" SelectedItem="{Binding FontFamily}" Width="220" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="历史条数" VerticalAlignment="Center" Width="72"/>
                  <TextBox Text="{Binding MaxMessages, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="保留秒数" VerticalAlignment="Center" Width="72"/>
                  <TextBox Text="{Binding DanmuExpireSeconds, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"
                           ToolTip="弹幕出现多少秒后自动消失（不再停在窗口里）；0 = 永久保留，只按「历史条数」截断"/>
                </StackPanel>
                <TextBlock Text="保留秒数设 0 = 不自动消失；两窗各自独立设置" Foreground="#FF888888" FontSize="11" Margin="0,0,0,6"/>
                <CheckBox Content="显示账号信息" IsChecked="{Binding ShowUserInfo}" Foreground="#FFCCCCCC" Margin="0,4"/>
                <CheckBox Content="显示勋章" IsChecked="{Binding ShowMedal}" Foreground="#FFCCCCCC" Margin="0,4"/>
                <CheckBox Content="显示时间" IsChecked="{Binding ShowTime}" Foreground="#FFCCCCCC" Margin="0,4"/>
                <CheckBox Content="显示在线/看过/赞" IsChecked="{Binding ShowStats}" Foreground="#FFCCCCCC" Margin="0,4"
                          ToolTip="弹幕窗顶部统计条；关闭后整条收起、弹幕区占满全窗"/>

                <!-- 用户名 / 弹幕 文本样式（字体 + 颜色，各自独立可配） -->
                <TextBlock Text="用户名样式" Foreground="#FFAAAAAA" Margin="0,8,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <TextBlock Text="字体" VerticalAlignment="Center" Width="72"/>
                  <ComboBox ItemsSource="{Binding SystemFonts}" SelectedItem="{Binding UserNameFontFamily}" Width="220" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <TextBlock Text="颜色" VerticalAlignment="Center" Width="72"/>
                  <TextBox Text="{Binding UserNameColor, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"/>
                  <Rectangle Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{Binding UserNameColor}" Stroke="#FF555555"/>
                </StackPanel>

                <TextBlock Text="弹幕样式" Foreground="#FFAAAAAA" Margin="0,6,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <TextBlock Text="字体" VerticalAlignment="Center" Width="72"/>
                  <ComboBox ItemsSource="{Binding SystemFonts}" SelectedItem="{Binding DanmuFontFamily}" Width="220" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <TextBlock Text="颜色" VerticalAlignment="Center" Width="72"/>
                  <TextBox Text="{Binding DanmuColor, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"/>
                  <Rectangle Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{Binding DanmuColor}" Stroke="#FF555555"/>
                </StackPanel>
                <TextBlock Text="颜色填 #RRGGBB 或 #AARRGGBB；改字体/颜色实时生效" Foreground="#FF888888" FontSize="11" Margin="0,0,0,6"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- 进场 / 关注 设置（独立窗口：字体 / 字号 / 透明度 / 开关） -->
          <TabItem Header="进场/关注">
            <TabItem.Resources>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFCCCCCC"/>
              </Style>
            </TabItem.Resources>
            <StackPanel Margin="6">
              <CheckBox Content="接收进场（进入直播间）" IsChecked="{Binding ShowEntry}" Foreground="#FFCCCCCC" Margin="0,2"
                        ToolTip="关闭后不再显示「进入直播间」"/>
              <CheckBox Content="接收关注" IsChecked="{Binding ShowFollow}" Foreground="#FFCCCCCC" Margin="0,2"
                        ToolTip="关闭后不再显示「关注了主播」"/>
              <CheckBox Content="接收礼物" IsChecked="{Binding ShowGift}" Foreground="#FFCCCCCC" Margin="0,2"
                        ToolTip="礼物/舰长与进场/关注一起显示在本窗口（主弹幕窗不再显示礼物）；舰长（GUARD_BUY）也按礼物处理，受此开关控制"/>
              <CheckBox Content="接收SC（醒目留言）" IsChecked="{Binding ShowSuperChat}" Foreground="#FFCCCCCC" Margin="0,2"
                        ToolTip="B站醒目留言与进场/关注/礼物一起显示在本窗口（主弹幕窗不再显示SC）"/>
              <TextBlock Text="可只收进场、关注、礼物、SC 的任意组合（关闭=过滤，不进任何窗）" Foreground="#FF888888" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"/>

              <CheckBox Content="显示进场/关注窗口" IsChecked="{Binding ShowNotifyWindow}" Foreground="#FFCCCCCC" Margin="0,2"
                        ToolTip="隐藏整个进场/关注窗口（消息仍会在后台接收，但需上一项开启）"/>
              <TextBlock Text="隐藏后该窗口不显示（可随时再打开）" Foreground="#FF888888" FontSize="11" Margin="0,2,0,8"/>

              <CheckBox Content="悬浮（沉浸置顶 · 鼠标穿透）" IsChecked="{Binding IsNotifyFloating}" Foreground="#FFCCCCCC" Margin="0,2"
                        ToolTip="置顶 + 鼠标完全穿透。退出在此取消勾选"/>
              <CheckBox Content="显示时间" IsChecked="{Binding NotifyShowTime}" Foreground="#FFCCCCCC" Margin="0,4"
                        ToolTip="每条消息前显示 HH:mm:ss 时间戳（独立于弹幕窗的时间开关）"/>

              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="背景透明度" VerticalAlignment="Center" Width="72"/>
                <Slider Minimum="0.3" Maximum="1" Value="{Binding NotifyOpacity}" TickFrequency="0.05" Width="220" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="字号" VerticalAlignment="Center" Width="72"/>
                <Slider Minimum="8" Maximum="100" Value="{Binding NotifyFontSize}" TickFrequency="1" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center"
                        ToolTip="8~100（4K 大屏可开大）"/>
              </StackPanel>
              <!-- 文字描边（通知窗独立设置） -->
              <CheckBox Content="文字描边" IsChecked="{Binding NotifyOutline}" Foreground="#FFCCCCCC" Margin="0,4"
                        ToolTip="给进场/关注/礼物文字加一圈硬描边（独立于弹幕窗的描边设置）"/>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="描边色" VerticalAlignment="Center" Width="72"/>
                <Button Width="34" Height="22" Click="OnPickNotifyOutlineColor" ToolTip="点开颜色盘选择"
                        Background="{Binding NotifyOutlineColor}" BorderBrush="#FF888888"/>
                <TextBox Text="{Binding NotifyOutlineColor, UpdateSourceTrigger=PropertyChanged}" Width="78" Margin="6,0,0,0" VerticalAlignment="Center"
                         ToolTip="也可手填 #RRGGBB / #AARRGGBB"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="描边粗细" VerticalAlignment="Center" Width="72"/>
                <Slider Minimum="0.5" Maximum="6" Value="{Binding NotifyOutlineThickness}" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="字体" VerticalAlignment="Center" Width="72"/>
                <ComboBox ItemsSource="{Binding SystemFonts}" SelectedItem="{Binding NotifyFontFamily}" Width="220" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="保留秒数" VerticalAlignment="Center" Width="72"/>
                <TextBox Text="{Binding NotifyExpireSeconds, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"
                         ToolTip="进场/关注/礼物/SC 出现多少秒后自动消失；0 = 永久保留（独立于弹幕窗的保留秒数）"/>
              </StackPanel>
              <TextBlock Text="进场/关注是独立窗口，可单独拖动、调节大小；悬浮后窗口鼠标穿透、不可点，取消上方勾选退出" Foreground="#FF888888" FontSize="11" Margin="0,8,0,6" TextWrapping="Wrap"/>
            </StackPanel>
          </TabItem>

          <!-- 弹幕朗读（三引擎：Edge 在线 Azure 神经音 / GPT-SoVITS 音色克隆 / 系统内置 SAPI；朗读独立于显示） -->
          <TabItem Header="朗读">
            <TabItem.Resources>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFCCCCCC"/>
              </Style>
            </TabItem.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="6">
                <CheckBox Content="启用弹幕朗读" IsChecked="{Binding TtsEnabled}" Foreground="#FFCCCCCC" Margin="0,2"
                          ToolTip="开启后，聊天/SC/礼物按所选引擎合成播放。朗读独立于显示"/>
                <!-- 引擎选择（三档：Edge 在线默认 / GPT-SoVITS 克隆 / 系统内置 SAPI） -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="语音引擎" VerticalAlignment="Center" Width="72"/>
                  <RadioButton Content="Edge 在线（推荐·零配置）" GroupName="TtsEngine" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                               IsChecked="{Binding TtsEngine, Converter={StaticResource StringEquals}, ConverterParameter=Edge}"
                               ToolTip="Azure 神经音色（晓晓/云希等），免部署、免 key、免参考音频。需联网（直播本就联网）。音质远胜系统内置"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Text="" Width="72"/>
                  <RadioButton Content="GPT-SoVITS（克隆音色）" GroupName="TtsEngine" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                               IsChecked="{Binding TtsEngine, Converter={StaticResource StringEquals}, ConverterParameter=GptSoVits}"
                               ToolTip="音色克隆，需本地 GPT-SoVITS 服务 + 3~10 秒参考音频，音质最像、可克隆主播声音"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Text="" Width="72"/>
                  <RadioButton Content="系统内置（免参考音频）" GroupName="TtsEngine" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                               IsChecked="{Binding TtsEngine, Converter={StaticResource StringEquals}, ConverterParameter=System}"
                               ToolTip="零配置：用 Windows 自带语音（如 Microsoft Huihui 中文）。免参考音频、离线可用；音色取决于系统已装语音包，偏机械"/>
                </StackPanel>
                <CheckBox Content="读 弹幕" IsChecked="{Binding TtsReadDanmu}" Foreground="#FFCCCCCC" Margin="0,2"/>
                <CheckBox Content="读 SC（醒目留言）" IsChecked="{Binding TtsReadSuperChat}" Foreground="#FFCCCCCC" Margin="0,2"/>
                <CheckBox Content="读 礼物" IsChecked="{Binding TtsReadGift}" Foreground="#FFCCCCCC" Margin="0,2"/>
                <CheckBox Content="读 用户名（xx 说：…）" IsChecked="{Binding TtsReadUserName}" Foreground="#FFCCCCCC" Margin="0,2"
                          ToolTip="关掉则只读正文，不念用户名"/>
                <!-- Edge 在线 专属 -->
                <StackPanel Visibility="{Binding TtsEngine, Converter={StaticResource StringEquals}, ConverterParameter=Edge}">
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="音色" VerticalAlignment="Center" Width="72"/>
                    <ComboBox ItemsSource="{Binding EdgeVoices}" DisplayMemberPath="Display"
                              SelectedValue="{Binding TtsEdgeVoice}" SelectedValuePath="Id" Width="220"
                              ToolTip="Azure 神经音色：普通话 6 个 + 东北话/陕西话 + 粤语 3 个 + 台湾 3 个。下拉显示中文名，存的是音色 ID"/>
                  </StackPanel>
                </StackPanel>
                <!-- GPT-SoVITS 专属 -->
                <StackPanel Visibility="{Binding TtsEngine, Converter={StaticResource StringEquals}, ConverterParameter=GptSoVits}">
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="服务地址" VerticalAlignment="Center" Width="72"/>
                    <TextBox Text="{Binding TtsServerUrl, UpdateSourceTrigger=PropertyChanged}" Width="220" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="参考音频*" VerticalAlignment="Center" Width="72"/>
                    <TextBox Text="{Binding TtsRefAudioPath, UpdateSourceTrigger=PropertyChanged}" Width="170" VerticalAlignment="Center"
                             ToolTip="克隆参考音频绝对路径（必填：GPT-SoVITS 靠它克隆音色，V2 无默认音色，须 3~10 秒）"/>
                    <Button Content="…" Click="OnPickTtsRefAudio" Width="28" Margin="4,0,0,0" ToolTip="选择克隆参考音频(wav)"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="参考文本" VerticalAlignment="Center" Width="72"/>
                    <TextBox Text="{Binding TtsPromptText, UpdateSourceTrigger=PropertyChanged}" Width="220" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="语气" VerticalAlignment="Center" Width="72"/>
                    <Slider Minimum="0.1" Maximum="1.5" Value="{Binding TtsTemperature}" TickFrequency="0.05" Width="220" VerticalAlignment="Center"
                            ToolTip="采样温度=语气表现力：高=更丰富多变，低=更平稳；基础音色仍由参考音频定（默认 1.0）"/>
                  </StackPanel>
                </StackPanel>
                <!-- 系统内置 专属 -->
                <StackPanel Visibility="{Binding TtsEngine, Converter={StaticResource StringEquals}, ConverterParameter=System}">
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="音色" VerticalAlignment="Center" Width="72"/>
                    <ComboBox ItemsSource="{Binding SystemVoices}" SelectedItem="{Binding TtsSystemVoice}" Width="220"
                              ToolTip="系统已安装的语音（空=系统默认）"/>
                  </StackPanel>
                </StackPanel>
                <!-- 通用 -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="语速" VerticalAlignment="Center" Width="72"/>
                  <Slider Minimum="0.5" Maximum="2" Value="{Binding TtsSpeed}" TickFrequency="0.1" Width="220" VerticalAlignment="Center"
                          ToolTip="GPT-SoVITS speed_factor / 系统 Rate 均按此映射"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="音量" VerticalAlignment="Center" Width="72"/>
                  <Slider Minimum="0" Maximum="1" Value="{Binding TtsVolume}" TickFrequency="0.05" Width="220" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="队列容量" VerticalAlignment="Center" Width="72"/>
                  <TextBox Text="{Binding TtsQueueCapacity, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="最长字数" VerticalAlignment="Center" Width="72"/>
                  <TextBox Text="{Binding TtsMaxLength, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="屏蔽词" VerticalAlignment="Center" Width="72"/>
                  <TextBox Text="{Binding TtsBlockedWords, UpdateSourceTrigger=PropertyChanged}" Width="220" VerticalAlignment="Center"
                           ToolTip="逗号分隔，命中任一则不读"/>
                </StackPanel>
                <Button Content="测试朗读" Command="{Binding TestTtsCommand}" Margin="0,6,0,4" HorizontalAlignment="Left"/>
                <TextBlock Text="Edge 在线：Azure 神经音色，免部署免 key（需联网；非官方端点，偶发失效时切系统内置兜底）。GPT-SoVITS：需本地启动 api（默认 127.0.0.1:9880）+ 3~10 秒参考音频，可克隆音色。系统内置：零配置离线，音色偏机械。切换引擎/音色立即生效；朗读与显示各自独立" Foreground="#FF888888" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- 定向回复：弹幕命中关键词 → 不读原弹幕，改念指定文字 / 播放指定音频（wav/mp3）；
               规则从上往下匹配，前面命中后不再判断后面的 -->
          <TabItem Header="定向回复">
            <TabItem.Resources>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFCCCCCC"/>
              </Style>
            </TabItem.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="6">
                <CheckBox Content="启用定向回复" IsChecked="{Binding ReplyRulesEnabled}" Foreground="#FFCCCCCC" Margin="0,0,0,4"
                          ToolTip="总开关：关闭后所有规则都不参与匹配（配置保留，随时勾回）。临时停某一条用每行开头的勾选框"/>
                <TextBlock Text="弹幕命中关键词 → 不读这条弹幕，改念一句指定的话，或播放一段音频（wav/mp3）" TextWrapping="Wrap"/>
                <TextBlock Text="规则从上往下匹配，前面的命中后不再判断后面的。独立于「读弹幕」开关（可关掉普通弹幕朗读、只留定向回复）；只对弹幕正文生效，礼物/SC/进场不触发" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"/>
                <Button Content="＋ 添加规则" Command="{Binding AddReplyRuleCommand}" HorizontalAlignment="Left" Margin="0,0,0,2"/>
                <ItemsControl ItemsSource="{Binding ReplyRules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FF2A2A2A" CornerRadius="3" Padding="6" Margin="0,4,0,0">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0"
                                      ToolTip="不勾选 = 临时禁用这条规则（配置保留，随时勾回）"/>
                            <TextBlock Text="关键词" Width="56" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalAlignment="Center"
                                     ToolTip="弹幕正文包含该词即命中（不分大小写）"/>
                            <Button Content="↑" Command="{Binding DataContext.MoveReplyRuleUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Width="24" Margin="8,0,2,0" ToolTip="上移（越靠上越先匹配）"/>
                            <Button Content="↓" Command="{Binding DataContext.MoveReplyRuleDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Width="24" Margin="2,0,2,0" ToolTip="下移"/>
                            <Button Content="删" Command="{Binding DataContext.RemoveReplyRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Width="30" Margin="2,0,0,0" ToolTip="删除这条规则"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="回复方式" Width="56" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:ReplyRuleViewModel.ActionOptions}}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                      SelectedValue="{Binding Action}" Width="90" VerticalAlignment="Center"/>
                            <Button Content="试听" Command="{Binding DataContext.TestReplyRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Margin="8,0,0,0" ToolTip="直接播一次这条规则的回复（需已填内容）"/>
                          </StackPanel>
                          <!-- 回复文字（方式=念文字 时显示） -->
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                      Visibility="{Binding Action, Converter={StaticResource StringEquals}, ConverterParameter=text}">
                            <TextBlock Text="回复文字" Width="56" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="220" VerticalAlignment="Center"
                                     ToolTip="命中后念这句话（原样念：不走屏蔽词/字数上限/读用户名）"/>
                          </StackPanel>
                          <!-- 音频文件（方式=播音频 时显示） -->
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                      Visibility="{Binding Action, Converter={StaticResource StringEquals}, ConverterParameter=sound}">
                            <TextBlock Text="音频文件" Width="56" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SoundPath, UpdateSourceTrigger=PropertyChanged}" Width="170" VerticalAlignment="Center"
                                     ToolTip="命中后播放的本地 wav / mp3（音量随「朗读」TAB 音量滑杆）"/>
                            <Button Content="…" Click="OnPickReplySound" Width="28" Margin="4,0,0,0" ToolTip="选择音频文件(wav/mp3)"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="典型用法：常问的问题（怎么加好友/几点下播）配一句固定答复；口号/梗配一段音效。改动即时生效，随设置自动保存" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,6"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- Cookie（B站专用；扫码登录自动填入，只读不可手改；抖音匿名连接，整段隐藏） -->
        <StackPanel Visibility="{Binding IsBilibili, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Cookie" Foreground="#FFCCCCCC" Margin="0,6,0,2"/>
          <TextBox Text="{Binding Cookie}" Width="312" Margin="0,0,0,4"
                   IsReadOnly="True" IsReadOnlyCaretVisible="False"
                   TextWrapping="NoWrap" HorizontalAlignment="Left"
                   ToolTip="由扫码登录自动填入，不可手动修改"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="扫码登录" Click="OnQrLoginClick" Margin="0,0,4,0"/>
          </StackPanel>
          <TextBlock Text="Cookie 由扫码登录自动填入（只读，不可手改）；下次连接生效" Foreground="#FF888888" FontSize="11" Margin="0,0,0,6"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
